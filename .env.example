# Copy to .env and fill in. .env is git-ignored.
# Sandbox values shown; for a real clinic swap BASE_URL, CLIENT_ID and GROUP_ID
# (and register the production JWKS URL on the app).

EPIC_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth
EPIC_CLIENT_ID=<non-production client id>
EPIC_GROUP_ID=<group id>

# Must match the "kid" in jwks.json
EPIC_KID=epic-test-key

# Relative to the repo root
PRIVATE_KEY_PATH=auth/keys/private-key.pem
